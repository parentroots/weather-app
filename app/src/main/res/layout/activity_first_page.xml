<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".FirstPageActivity"
    android:background="@drawable/layout_bg"
    >

    <ImageView
        android:id="@+id/cloudyIcon"
        android:layout_width="300dp"
        android:layout_height="200dp"
        android:src="@drawable/cloudyicon"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"
        />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="400dp"
        android:layout_alignParentBottom="true"
        android:background="@drawable/curv_bg"
        >
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            >

            <ImageView
                android:id="@+id/minusId"
                android:layout_width="30dp"
                android:layout_height="40dp"
                android:src="@drawable/minus"
                android:layout_centerHorizontal="true"
                />

            <TextView
                android:id="@+id/headerText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Weather Forecast And News Feed"
                android:textSize="40sp"
                android:textStyle="bold"
                android:layout_below="@id/minusId"
                android:layout_centerHorizontal="true"
                android:gravity="center_horizontal"
                android:textColor="#000000"
                android:layout_margin="10dp"
                />

            <TextView
                android:id="@+id/quotsText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Like raindrops, not every moment in life is clear—but each one holds its own beauty"
                android:layout_below="@id/headerText"
                android:gravity="center_horizontal"
                android:layout_margin="10dp"
                android:textColor="#000000"
                android:textSize="16sp"
                android:fontFamily="monospace"
                />


            <androidx.cardview.widget.CardView
                android:layout_width="300dp"
                android:layout_height="60dp"
                android:layout_centerHorizontal="true"
                android:layout_below="@id/quotsText"
                app:cardCornerRadius="20dp"
                android:layout_marginTop="40dp"
                app:cardBackgroundColor="#00FFFB"
                >
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center_vertical"

                    >
                    <ImageView
                        android:id="@+id/nextButton"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/next_button"
                        android:layout_marginLeft="10dp"

                        />

                    
                </LinearLayout>



            </androidx.cardview.widget.CardView>




        </RelativeLayout>


    </LinearLayout>




</RelativeLayout>